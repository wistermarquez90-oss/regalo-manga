---
import Layout from '../layouts/Layout.astro';
import BotonTema from '../components/BotonTema.astro';
---
<Layout title="¡Feliz Cumpleaños!">
  <nav class="flex justify-between items-center p-6 max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold italic">Para Ti</h1>
    <BotonTema />
  </nav>

  <main class="max-w-4xl mx-auto p-6 flex flex-col items-center justify-center min-h-[70vh] text-center gap-8">
    <h2 class="text-5xl md:text-7xl font-bold tracking-tight">Feliz Cumpleaños</h2>
    <p class="text-lg opacity-80 max-w-md">He preparado algo muy especial. Elige por dónde quieres empezar.</p>
    
    <div class="flex gap-4 mt-4">
      <a href="/carta" class="px-6 py-3 border border-gray-800 dark:border-gray-200 rounded-full hover:bg-gray-800 hover:text-[#fdfbf7] dark:hover:bg-gray-200 dark:hover:text-[#1a1918] transition-colors">Leer Carta</a>
      <a href="/manga" class="px-6 py-3 border border-gray-800 dark:border-gray-200 rounded-full hover:bg-gray-800 hover:text-[#fdfbf7] dark:hover:bg-gray-200 dark:hover:text-[#1a1918] transition-colors">Ver Manga</a>
      <a href="/musica" class="px-6 py-3 border border-gray-800 dark:border-gray-200 rounded-full hover:bg-gray-800 hover:text-[#fdfbf7] dark:hover:bg-gray-200 dark:hover:text-[#1a1918] transition-colors">Música</a>
    </div>
  </main>
</Layout>