---
import Layout from '../layouts/Layout.astro';
import BotonTema from '../components/BotonTema.astro';

// Obtenemos la ruta base correcta para GitHub Pages
const base = import.meta.env.BASE_URL;
---

<Layout title="¡Feliz Cumpleaños!">
  <!-- Navegación superior -->
  <nav class="flex justify-between items-center p-6 max-w-4xl mx-auto w-full relative z-10 animate-fade-in-down">
    <h1 class="text-2xl font-bold italic tracking-wider">Para Ti</h1>
    <BotonTema />
  </nav>

  <!-- Contenido principal -->
  <main class="w-full max-w-4xl mx-auto p-6 flex-1 flex flex-col items-center justify-center text-center gap-10 relative z-10">
    
    <div class="space-y-6">
      <div class="animate-fade-in-up">
        <h2 class="text-6xl md:text-8xl font-bold tracking-tight transition-all duration-300 hover:text-amber-500 dark:hover:text-amber-400 hover:scale-110 hover:drop-shadow-[0_0_25px_rgba(251,191,36,0.8)] inline-block cursor-default origin-center">
          Feliz Cumpleaños
        </h2>
      </div>
      
      <p class="text-xl md:text-2xl opacity-80 max-w-lg mx-auto italic font-light animate-fade-in-up [animation-delay:200ms] transition-all duration-300 hover:opacity-100 hover:text-amber-600 dark:hover:text-amber-300 cursor-default">
        He preparado algo muy especial. Elige por dónde quieres empezar.
      </p>
    </div>
    
    <!-- Botones con enlaces corregidos usando la variable base -->
    <div class="animate-fade-in-up [animation-delay:400ms]">
      <div class="flex flex-wrap justify-center gap-4 mt-8">
        <a href={`${base}carta`} class="px-8 py-3 rounded-full border border-gray-300/50 dark:border-white/10 bg-white/40 dark:bg-white/5 backdrop-blur-md hover:bg-amber-50 dark:hover:bg-white/10 hover:border-amber-200 dark:hover:border-amber-500/30 hover:scale-110 hover:-translate-y-1 hover:shadow-[0_10px_20px_rgba(251,191,36,0.15)] transition-all duration-300 shadow-sm text-lg font-medium inline-block">
          Leer Carta
        </a>
        <a href={`${base}manga`} class="px-8 py-3 rounded-full border border-gray-300/50 dark:border-white/10 bg-white/40 dark:bg-white/5 backdrop-blur-md hover:bg-amber-50 dark:hover:bg-white/10 hover:border-amber-200 dark:hover:border-amber-500/30 hover:scale-110 hover:-translate-y-1 hover:shadow-[0_10px_20px_rgba(251,191,36,0.15)] transition-all duration-300 shadow-sm text-lg font-medium inline-block">
          Ver Manga
        </a>
        <a href={`${base}musica`} class="px-8 py-3 rounded-full border border-gray-300/50 dark:border-white/10 bg-white/40 dark:bg-white/5 backdrop-blur-md hover:bg-amber-50 dark:hover:bg-white/10 hover:border-amber-200 dark:hover:border-amber-500/30 hover:scale-110 hover:-translate-y-1 hover:shadow-[0_10px_20px_rgba(251,191,36,0.15)] transition-all duration-300 shadow-sm text-lg font-medium inline-block">
          Música
        </a>
      </div>
    </div>

  </main>
</Layout>