---
import Layout from '../layouts/Layout.astro';
import BotonTema from '../components/BotonTema.astro';

// Obtenemos la ruta base correcta para GitHub Pages
const base = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

// Lista de las 5 páginas del manga
const paginas = [
  `${base}pagina1.jpg`,
  `${base}pagina2.jpg`,
  `${base}pagina3.jpg`,
  `${base}pagina4.jpg`,
  `${base}pagina5.jpg`,
];
---

<Layout title="Capítulo Especial">
  <!-- Reproductor de música en bucle de fondo -->
  <audio id="background-audio" src="https://www.youtube.com/watch?v=Zrn3I_LM9xA" loop preload="auto"></audio>

  <!-- Botón flotante de música (para controlar si se desea silenciar/reproducir) -->
  <button id="music-toggle" class="fixed bottom-6 right-6 z-50 px-4 py-2 rounded-full border border-violet-200 dark:border-white/20 bg-white/70 dark:bg-black/60 backdrop-blur-md shadow-lg text-xs md:text-sm font-medium flex items-center gap-2 text-violet-950 dark:text-amber-200 hover:scale-105 transition-all">
    <span id="music-icon">🎵</span> <span id="music-text">Música: Activada</span>
  </button>

  <!-- Barra superior pegajosa -->
  <nav class="sticky top-0 w-full bg-white/70 dark:bg-[#0a0908]/80 backdrop-blur-md z-50 border-b border-violet-100 dark:border-white/10 animate-fade-in-down transition-colors duration-500">
    <div class="max-w-3xl mx-auto p-4 flex justify-between items-center">
      <a href={base} class="text-sm font-medium opacity-70 hover:opacity-100 hover:text-violet-700 dark:hover:text-amber-400 transition-all flex items-center gap-2">
        ← Volver
      </a>
      <h1 class="font-bold italic text-lg text-violet-950 dark:text-amber-100 tracking-wider">Capítulo Único</h1>
      <BotonTema />
    </div>
  </nav>

  <!-- Contenedor del Manga en formato cascada vertical -->
  <main class="w-full max-w-2xl mx-auto flex flex-col items-center justify-center min-h-screen relative z-10 pt-8 pb-20 px-4 md:px-0">
    
    <div class="w-full shadow-2xl animate-fade-in-up bg-white/50 dark:bg-black/50 overflow-hidden rounded-md border border-white/20 dark:border-white/5 flex flex-col">
      {paginas.map((pagina) => (
        <img 
          src={pagina} 
          alt="Página del manga" 
          class="w-full h-auto object-contain block m-0 p-0"
          loading="lazy" 
        />
      ))}
    </div>

    <!-- Mensaje y botón al finalizar -->
    <div class="mt-20 text-center flex flex-col items-center gap-6 animate-fade-in-up [animation-delay:300ms]">
      <p class="text-3xl italic font-bold text-violet-900 dark:text-amber-400">Continuará...</p>
      <p class="text-lg opacity-80 max-w-md">Espero que te haya gustado esta sorpresa. Aún hay más por descubrir.</p>
      
      <a href={`${base}carta/`} class="mt-4 px-8 py-3 rounded-full border border-violet-200 dark:border-white/10 bg-white/60 dark:bg-white/5 backdrop-blur-md hover:bg-violet-50 dark:hover:bg-white/10 hover:border-violet-300 dark:hover:border-amber-500/30 hover:scale-110 hover:-translate-y-1 hover:shadow-[0_10px_20px_rgba(139,92,246,0.15)] dark:hover:shadow-[0_10px_20px_rgba(251,191,36,0.15)] transition-all duration-300 shadow-sm text-lg font-medium text-violet-950 dark:text-white inline-block">
        Leer la carta especial
      </a>
    </div>
  </main>

  <!-- Script para la reproducción automática y el botón de control -->
  <script>
    document.addEventListener('astro:page-load', () => {
      const audio = document.getElementById('background-audio') as HTMLAudioElement;
      const musicToggle = document.getElementById('music-toggle');
      const musicText = document.getElementById('music-text');
      const musicIcon = document.getElementById('music-icon');

      if (audio) {
        audio.volume = 0.5; // Volumen agradable al 50%
        // Intentar reproducir automáticamente al entrar
        audio.play().catch(() => {
          // Si el navegador bloquea la reproducción automática, se activará al primer clic
          if (musicText) musicText.textContent = 'Toca aquí para reproducir música';
        });
      }

      musicToggle?.addEventListener('click', () => {
        if (audio.paused) {
          audio.play();
          if (musicText) musicText.textContent = 'Música: Activada';
          if (musicIcon) musicIcon.textContent = '🎵';
        } else {
          audio.pause();
          if (musicText) musicText.textContent = 'Música: Pausada';
          if (musicIcon) musicIcon.textContent = '🔇';
        }
      });
    });
  </script>
</Layout>