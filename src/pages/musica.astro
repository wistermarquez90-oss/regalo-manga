---

<Layout title="Nuestra Música Especial">
  
  <!-- Barra superior pegajosa -->
  <nav class="sticky top-0 w-full bg-white/70 dark:bg-[#0a0908]/80 backdrop-blur-md z-50 border-b border-violet-100 dark:border-white/10 animate-fade-in-down transition-colors duration-500">
    <div class="max-w-4xl mx-auto p-4 flex justify-between items-center">
      <a href={base} class="text-sm font-medium opacity-70 hover:opacity-100 hover:text-violet-700 dark:hover:text-amber-400 transition-all flex items-center gap-2">
        ← Volver al inicio
      </a>
      <h1 class="font-bold italic text-lg text-violet-950 dark:text-amber-100 tracking-wider">Rincón Musical</h1>
      <BotonTema />
    </div>
  </nav>

  <!-- Contenido Principal -->
  <main class="w-full max-w-4xl mx-auto p-6 relative z-10 flex flex-col gap-8 pb-20">
    
    <!-- Título de sección -->
    <div class="text-center space-y-2 animate-fade-in-up">
      <h2 class="text-3xl md:text-5xl font-bold text-violet-900 dark:text-amber-400 tracking-tight">
        Nuestras Canciones
      </h2>
      <p class="text-base md:text-lg opacity-80 max-w-lg mx-auto">
        Elige una melodía, relájate y disfruta de su letra.
      </p>
    </div>

    <!-- Contenedor Principal en Grid (Lista a un lado, Reproductor y Letra al otro) -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      
      <!-- Lista de Canciones (Columna izquierda) -->
      <div class="md:col-span-5 bg-white/40 dark:bg-black/30 backdrop-blur-md p-4 rounded-2xl border border-violet-100 dark:border-white/10 shadow-xl animate-fade-in-up flex flex-col gap-2">
        <h3 class="text-sm font-semibold uppercase tracking-wider px-3 py-2 text-violet-800 dark:text-amber-300">
          Lista de Reproducción
        </h3>
        <div id="playlist-container" class="flex flex-col gap-2 max-h-[450px] overflow-y-auto pr-1">
          {canciones.map((cancion, index) => (
            <button 
              data-index={index}
              data-id={cancion.id}
              class="song-btn text-left px-4 py-3 rounded-xl transition-all flex items-center justify-between group border border-transparent hover:border-violet-300 dark:hover:border-amber-500/30 hover:bg-violet-50/60 dark:hover:bg-white/10 cursor-pointer"
            >
              <div>
                <p class="font-bold text-gray-900 dark:text-gray-100 group-hover:text-violet-700 dark:group-hover:text-amber-400 transition-colors">
                  {cancion.titulo}
                </p>
                <p class="text-xs opacity-70">{cancion.artista}</p>
              </div>
              <span class="text-violet-600 dark:text-amber-400 opacity-0 group-hover:opacity-100 transition-opacity text-sm">▶</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Reproductor y Letra de la Canción (Columna derecha) -->
      <div class="md:col-span-7 bg-white/50 dark:bg-black/40 backdrop-blur-md p-6 md:p-8 rounded-3xl border border-violet-100 dark:border-white/10 shadow-2xl animate-fade-in-up flex flex-col gap-6">
        
        <!-- Info de la canción activa -->
        <div class="flex justify-between items-center border-b border-violet-100 dark:border-white/10 pb-4">
          <div>
            <span id="current-artist" class="text-xs font-semibold uppercase tracking-widest text-violet-600 dark:text-amber-400">Selecciona una canción</span>
            <h3 id="current-title" class="text-2xl font-bold text-violet-950 dark:text-white mt-1">Elige abajo</h3>
          </div>
          <button id="play-pause-btn" class="px-5 py-2.5 rounded-full bg-violet-600 hover:bg-violet-700 dark:bg-amber-500 dark:hover:bg-amber-600 text-white font-medium shadow-lg transition-all hover:scale-105 cursor-pointer text-sm">
            Reproducir / Pausa
          </button>
        </div>

        <!-- Reproductor de YouTube Oculto (Maneja el audio real) -->
        <div class="hidden">
          <div id="youtube-player"></div>
        </div>

        <!-- Visor de Letra de la Canción -->
        <div class="bg-white/60 dark:bg-black/40 p-6 rounded-2xl border border-violet-50 dark:border-white/5 shadow-inner min-h-[220px] max-h-[300px] overflow-y-auto flex flex-col justify-center text-center">
          <div id="lyrics-display" class="space-y-3 text-lg md:text-xl italic font-light opacity-90 leading-relaxed text-gray-800 dark:text-gray-200">
            <p class="opacity-60 not-italic text-sm">La letra aparecerá aquí al reproducir una canción...</p>
          </div>
        </div>

      </div>

    </div>

  </main>

  <!-- Script Interactivo de Música y Letras con YouTube API -->
  <script is:inline define:vars={{ canciones }}>
    let player;
    let currentSongIndex = 0;
    let isPlaying = false;

    // Cargar API de YouTube
    var tag = document.createElement('script');
    tag.src = "https://www.youtube.com/iframe_api";
    var firstScriptTag = document.getElementsByTagName('script')[0];
    firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

    window.onYouTubeIframeAPIReady = function() {
      player = new YT.Player('youtube-player', {
        height: '0',
        width: '0',
        videoId: canciones[0].id,
        playerVars: {
          'autoplay': 0,
          'controls': 0,
        },
        events: {
          'onReady': () => {
            initPlaylistControls();
          },
          'onStateChange': onPlayerStateChange
        }
      });
    }

    function initPlaylistControls() {
      const buttons = document.querySelectorAll('.song-btn');
      const playPauseBtn = document.getElementById('play-pause-btn');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const index = parseInt(btn.getAttribute('data-index'));
          loadSong(index);
        });
      });

      playPauseBtn?.addEventListener('click', () => {
        if (!player) return;
        const state = player.getPlayerState();
        if (state === YT.PlayerState.PLAYING) {
          player.pauseVideo();
        } else {
          player.playVideo();
        }
      });

      // Cargar la primera por defecto (sin play automático para respetar restricciones del navegador)
      loadSong(0, false);
    }

    function loadSong(index, autoPlay = true) {
      currentSongIndex = index;
      const song = canciones[index];

      // Actualizar textos en pantalla
      document.getElementById('current-title').textContent = song.titulo;
      document.getElementById('current-artist').textContent = song.artista;

      // Actualizar Letra
      const lyricsContainer = document.getElementById('lyrics-display');
      lyricsContainer.innerHTML = song.letra.map(line => `<p>${line}</p>`).join('');

      // Resaltar botón activo en la lista
      document.querySelectorAll('.song-btn').forEach((b, i) => {
        if (i === index) {
          b.classList.add('bg-violet-100', 'dark:bg-white/20', 'border-violet-300', 'dark:border-amber-500/40');
        } else {
          b.classList.remove('bg-violet-100', 'dark:bg-white/20', 'border-violet-300', 'dark:border-amber-500/40');
        }
      });

      if (player && player.loadVideoById) {
        player.loadVideoById(song.id);
        if (!autoPlay) {
          player.pauseVideo();
        }
      }
    }

    function onPlayerStateChange(event) {
      const playPauseBtn = document.getElementById('play-pause-btn');
      if (event.data === YT.PlayerState.PLAYING) {
        isPlaying = true;
        if (playPauseBtn) playPauseBtn.textContent = 'Pausar ⏸';
      } else if (event.data === YT.PlayerState.PAUSED || event.data === YT.PlayerState.ENDED) {
        isPlaying = false;
        if (playPauseBtn) playPauseBtn.textContent = 'Reproducir ▶';
        
        // Si la canción termina, repetir en bucle automáticamente
        if (event.data === YT.PlayerState.ENDED) {
          player.playVideo();
        }
      }
    }
  </script>
</Layout>