---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Mi Carta para ti">
  <main class="max-w-2xl mx-auto p-8 mt-10">
    <a href="/" class="opacity-60 hover:opacity-100 transition-opacity">← Volver al inicio</a>
    <h1 class="text-4xl font-bold mt-8 mb-6">Una carta especial...</h1>
    <p class="text-lg leading-relaxed opacity-90">Aquí puedes escribir todo tu mensaje. Como usamos View Transitions, verás que llegar a esta página se sintió súper fluido.</p>
  </main>
</Layout>